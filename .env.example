# OKX API credentials
# Get them from: https://www.okx.com/account/my-api
OKX_API_KEY=your_api_key_here
OKX_SECRET=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# Telegram Bot
# 1. Utwórz bota: napisz do @BotFather → /newbot → skopiuj token
# 2. Sprawdź swoje Chat ID: napisz do @userinfobot
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
